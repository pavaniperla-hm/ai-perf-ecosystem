ENVIRONMENT=local

# ── Database connections (local Docker — host-mapped ports) ───────────────────
USER_DB_URL=postgresql://postgres:postgres@localhost:5433/userdb
PRODUCT_DB_URL=postgresql://postgres:postgres@localhost:5434/productdb
ORDER_DB_URL=postgresql://postgres:postgres@localhost:5435/orderdb

# ── k6 load testing ───────────────────────────────────────────────────────────
K6_BASE_URL=http://localhost:8080

# ── Grafana Cloud — shared API token ──────────────────────────────────────────
# Same token for Prometheus remote write AND Loki log push (metrics:write + logs:write)
# GRAFANA_API_TOKEN=  ← paste token here (never commit)

# ── Grafana Cloud — Prometheus remote write ───────────────────────────────────
K6_PROMETHEUS_RW_SERVER_URL=https://prometheus-prod-39-prod-eu-north-0.grafana.net/api/prom/push
K6_PROMETHEUS_RW_USERNAME=2997542
# K6_PROMETHEUS_RW_PASSWORD=  ← same as GRAFANA_API_TOKEN (never commit)

# ── Grafana Cloud — Loki ──────────────────────────────────────────────────────
LOKI_URL=https://logs-prod-025.grafana.net
LOKI_USERNAME=1494446
# LOKI_PASSWORD=  ← same as GRAFANA_API_TOKEN (never commit)

# ── Grafana Dashboard ─────────────────────────────────────────────────────────
GRAFANA_DASHBOARD_URL=https://myperformanceproject.grafana.net/d/k6-perf-v3

# ── Promtail ──────────────────────────────────────────────────────────────────
PROMTAIL_CONFIG=promtail/config.yml

# ── Loki query labels (used by analysis-agent to filter logs) ─────────────────
LOKI_LABEL_ENVIRONMENT=local
LOKI_JOB_NAME=docker-compose
LOKI_QUERY_FILTER={job="docker-compose"}

# ── Bug tracker routing ───────────────────────────────────────────────────────
BUG_TRACKER=jira
JIRA_PROJECT=SCRUM
JIRA_URL=https://pavani-perf-demo.atlassian.net
JIRA_WORK_ITEM_TYPE=Bug

# ── Dynatrace ─────────────────────────────────────────────────────────────────
# Dynatrace monitors AKS only — not available for local Docker stack
DYNATRACE_ENABLED=false
