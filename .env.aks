ENVIRONMENT=aks

# ── Database connections (AKS — via kubectl port-forward for local tools/MCP) ─
# Start port-forwards first:
#   kubectl port-forward -n perf-demo svc/user-db 15433:5432 &
#   kubectl port-forward -n perf-demo svc/product-db 15434:5432 &
#   kubectl port-forward -n perf-demo svc/order-db 15435:5432 &
USER_DB_URL=postgresql://postgres:postgres@localhost:15433/userdb
PRODUCT_DB_URL=postgresql://postgres:postgres@localhost:15434/productdb
ORDER_DB_URL=postgresql://postgres:postgres@localhost:15435/orderdb

# ── k6 load testing ───────────────────────────────────────────────────────────
K6_BASE_URL=http://20.82.174.115

# ── Grafana Cloud — shared API token ──────────────────────────────────────────
# Same token for Prometheus remote write AND Loki log push (metrics:write + logs:write)
# GRAFANA_API_TOKEN=  ← paste token here (never commit)

# ── Grafana Cloud — Prometheus remote write ───────────────────────────────────
K6_PROMETHEUS_RW_SERVER_URL=https://prometheus-prod-39-prod-eu-north-0.grafana.net/api/prom/push
K6_PROMETHEUS_RW_USERNAME=2997542
# K6_PROMETHEUS_RW_PASSWORD=  ← same as GRAFANA_API_TOKEN (never commit)

# ── Grafana Cloud — Loki ──────────────────────────────────────────────────────
LOKI_URL=https://logs-prod-025.grafana.net
LOKI_USERNAME=1494446
# LOKI_PASSWORD=  ← same as GRAFANA_API_TOKEN (never commit)

# ── Grafana Dashboard ─────────────────────────────────────────────────────────
GRAFANA_DASHBOARD_URL=https://myperformanceproject.grafana.net/d/k6-perf-v3

# ── Promtail ──────────────────────────────────────────────────────────────────
# Reads /var/log/pods via DaemonSet — managed by k8s/promtail/configmap.yaml
PROMTAIL_CONFIG=k8s/promtail/configmap.yaml

# ── Loki query labels (used by analysis-agent to filter logs) ─────────────────
LOKI_LABEL_ENVIRONMENT=aks
LOKI_JOB_NAME=kubernetes-pods
LOKI_QUERY_FILTER={namespace="perf-demo"}

# ── Bug tracker routing ───────────────────────────────────────────────────────
BUG_TRACKER=azure-devops
AZURE_DEVOPS_ORG=ai-perf-demo
AZURE_DEVOPS_PROJECT=ai-perf-project
AZURE_DEVOPS_WORK_ITEM_TYPE=Issue

# ── Dynatrace ─────────────────────────────────────────────────────────────────
# Full-stack observability: OneAgent + ActiveGate deployed to aks-monitoring pool
DYNATRACE_ENABLED=true
DYNATRACE_URL=https://kun86120.live.dynatrace.com
DYNATRACE_NAMESPACE_FILTER=perf-demo
# DYNATRACE_API_TOKEN=  ← paste token here (never commit)
